{"Version":"2012-10-17","Statement":[
 {"Effect":"Allow","Action":["s3:GetObject"],
  "Resource":["arn:aws:s3:::lapayments-ACCOUNT_ID/serving/*",
              "arn:aws:s3:::lapayments-ACCOUNT_ID/registers/serving_files.csv"]},
 {"Effect":"Allow","Action":["s3:ListBucket"],
  "Resource":"arn:aws:s3:::lapayments-ACCOUNT_ID",
  "Condition":{"StringLike":{"s3:prefix":["serving/*","registers/serving_files.csv"]}}}
]}
